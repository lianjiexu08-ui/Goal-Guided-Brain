NODE_ENV=production
WORKBENCH_DATA_DIR=/var/lib/dsh-workbench
WORKBENCH_PUBLIC_URL=https://workbench.example.com
WORKBENCH_REQUIRE_AUTH=1
WORKBENCH_API_PORT=3089
# Set a unique initial owner password of at least 12 characters before first start.
WORKBENCH_OWNER_PASSWORD=
# Supply vault unlock material separately from encrypted database backups.
WORKBENCH_VAULT_PASSWORD=
