[Unit]
Description=DSH Workbench execution node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh
Group=dsh
WorkingDirectory=/opt/dsh-workbench
EnvironmentFile=-/etc/dsh-node.env
ExecStart=/usr/bin/node /opt/dsh-workbench/scripts/node.mjs --config /etc/dsh-node.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
