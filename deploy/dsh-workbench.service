[Unit]
Description=DSH Workbench control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh
Group=dsh
WorkingDirectory=/opt/dsh-workbench
EnvironmentFile=/etc/dsh-workbench.env
ExecStart=/usr/bin/node /opt/dsh-workbench/scripts/start.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dsh-workbench /srv/dsh-projects

[Install]
WantedBy=multi-user.target
